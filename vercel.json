{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/essais/vercel/accueil.html"
    },
    {
      "source": "/modeles",
      "destination": "/essais/vercel/modeles.html"
    },
    {
      "source": "/boutique",
      "destination": "/essais/vercel/boutique/index.html"
    },
    {
      "source": "/boutique/:fichier*",
      "destination": "/essais/vercel/boutique/:fichier*"
    },
    {
      "source": "/vierge",
      "destination": "/essais/vercel/vierge.html"
    },
    {
      "source": "/distribution/admin/:chemin*",
      "destination": "/admin/:chemin*"
    }
  ]
}
