rules_version = '2';

// Règles Firebase Storage (adaptateur média « firebase »).
// Les images sont publiques en lecture — elles s'affichent sur le site — et
// ne peuvent être déposées que par un compte rattaché au site concerné.

service firebase.storage {
  match /b/{bucket}/o {
    match /sites/{siteId}/media/{fileName} {

      allow read: if true;

      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          firestore.exists(/databases/(default)/documents/sites/$(siteId)/members/$(request.auth.uid))
          || firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid))
        );

      allow delete: if request.auth != null
        && (
          firestore.exists(/databases/(default)/documents/sites/$(siteId)/members/$(request.auth.uid))
          || firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid))
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
