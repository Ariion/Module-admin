{
  "name": "module-admin",
  "version": "1.28.0",
  "description": "Interface d'édition visuelle pour sites statiques codés à la main. Firebase, aucun serveur, aucun build.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "http-server -p 8080 -c-1 .",
    "demo": "http-server -p 8080 -c-1 . -o /demo/index.html",
    "lint": "eslint admin",
    "sync": "node tools/sync.mjs",
    "essai-local": "node tools/essai-local.mjs",
    "essai-ecrans": "node tools/essai-ecrans.mjs",
    "essai-marque": "node tools/essai-marque.mjs",
    "essai-elements": "node tools/essai-elements.mjs",
    "essai-clavier": "node tools/essai-clavier.mjs",
    "essai-formulaire": "node tools/essai-formulaire.mjs",
    "essai-regles": "node tools/essai-regles.mjs",
    "paquet": "node tools/paquet.mjs",
    "livraison": "node tools/livraison.mjs"
  },
  "keywords": [
    "cms",
    "static-site",
    "firebase",
    "inline-editing",
    "no-build"
  ],
  "devDependencies": {
    "eslint": "^10.0.0",
    "http-server": "^14.1.1"
  },
  "files": [
    "admin",
    "firebase",
    "tools",
    "docs"
  ]
}
